# ---------------------------------------------------------------------------
# Disiplin — ortam değişkenleri ÖRNEĞİ
#
# Bu dosya depoya girer ve İÇİNDE GERÇEK DEĞER YOKTUR.
# Kullanımı:  bu dosyayı ".env.local" olarak kopyala, değerleri doldur.
# ".env.local" .gitignore tarafından engellenir, asla GitHub'a gitmez.
# ---------------------------------------------------------------------------

# Supabase proje URL'si (Supabase > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase "publishable" anahtarı (Project Settings > API Keys).
# Bu anahtar tarayıcıya gönderilmek üzere tasarlanmıştır; gizli değildir.
# Verileri koruyan şey anahtarın gizliliği değil, veritabanındaki RLS
# politikalarıdır (bkz. supabase/migrations).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# DİKKAT: "service_role" / "secret" anahtarı bu projede HİÇ KULLANILMAZ.
# O anahtar RLS'i tamamen devre dışı bırakır. Buraya veya herhangi bir
# NEXT_PUBLIC_* değişkenine asla yazma.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bildirimler (Faz 10)
# ---------------------------------------------------------------------------

# VAPID anahtar çifti: tarayıcının push servisine "bu bildirimi gönderen
# gerçekten o site" diyebilmesini sağlar. Üretmek için:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Açık anahtar tarayıcıya gider, gizli değildir.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gizli anahtar YALNIZCA sunucuda kalır. Tarayıcıya giderse herkes senin
# adına bildirim gönderebilir. Başına asla NEXT_PUBLIC_ yazma.
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOT: Hatırlatma uç noktasının paylaşılan sırrı BURADA DEĞİLDİR.
# O sır yalnızca Supabase Vault içinde durur; zamanlayıcı isteği onunla
# imzalar, uç nokta da doğruluğunu veritabanına sorar. Böylece sunucuda
# tutulması gereken tek gizli değer VAPID_PRIVATE_KEY olur.
