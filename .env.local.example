# ---------------------------------------------------------------------------
# Disiplin — ortam değişkenleri ÖRNEĞİ
#
# Bu dosya depoya girer ve İÇİNDE GERÇEK DEĞER YOKTUR.
# Kullanımı:  bu dosyayı ".env.local" olarak kopyala, değerleri doldur.
# ".env.local" .gitignore tarafından engellenir, asla GitHub'a gitmez.
# ---------------------------------------------------------------------------

# Supabase proje URL'si (Supabase > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase "anon" (publishable) anahtarı.
# Bu anahtar tarayıcıya gönderilmek üzere tasarlanmıştır; gizli değildir.
# Verileri koruyan şey anahtarın gizliliği değil, veritabanındaki RLS
# politikalarıdır (bkz. supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# DİKKAT: "service_role" / "secret" anahtarı bu projede HİÇ KULLANILMAZ.
# O anahtar RLS'i tamamen devre dışı bırakır. Buraya veya herhangi bir
# NEXT_PUBLIC_* değişkenine asla yazma.
# ---------------------------------------------------------------------------
